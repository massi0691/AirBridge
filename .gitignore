# ── macOS Finder ──
.DS_Store
.AppleDouble
.LSOverride

# ── Xcode ──
build/
DerivedData/
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.xcscmblueprint
*.xccheckout
*.xcscheme

# Backups Xcode
*.bak
*.backup-*
*.orig
*.swp
*.swo

# ── Swift Package Manager ──
.build/
Packages/
Package.resolved

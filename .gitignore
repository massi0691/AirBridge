# ── CocoaPods (non utilisé mais harmless) ──
Pods/

# ── Carthage (non utilisé mais harmless) ──
Carthage/Build/

# ── Logs de build (artefacts) ──
build.log
build_log.txt
*.log

# ── Fichiers npm (artefacts accidentels, projet n'utilise pas npm) ──
package-lock.json
node_modules/

# ── Fichiers temporaires ──
*.tmp
*.dump
*~
*.swp
